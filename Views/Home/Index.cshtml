@model AspNetCore_BookStore.ViewModels.HomeViewModel

@section Styles {
    <style>
        .book-card {
            border: 2px solid #333;
            padding: 15px;
            margin: 10px;
            width: 250px;
            border-radius: 8px;
            display: inline-block;
            vertical-align: top;
            background-color: #f9f9f9;
        }
    </style>
}

<h2>Manage Books & Authors</h2>

<div style="margin-bottom: 30px;">
    <h4>Add New Author</h4>
    <form method="post" action="/Home/AddAuthor">
        <input type="text" name="Name" placeholder="Author Name" required />
        <input type="text" name="Country" placeholder="Country" required />
        <button type="submit">Add Author</button>
    </form>
</div>

<div style="margin-bottom: 30px;">
    <h4>Add New Book</h4>
    <form method="post" action="/Home/AddBook">
        <input type="text" name="Title" placeholder="Book Title" required />
        <input type="number" step="0.01" name="Price" placeholder="Price" required />
        <select name="AuthorId">
            @foreach (var author in Model.Authors)
            {
                <option value="@author.Id">@author.Name</option>
            }
        </select>
        <button type="submit">Add Book</button>
    </form>
</div>

<hr />
<h3>Book List</h3>

@if (Model.Books.Count == 0)
{
    <p>No books available</p>
}
else
{
    <div>
        @foreach (var book in Model.Books)
        {
            <div class="book-card">
                <h5>@book.Title</h5>
                <p><strong>Author:</strong> @book.AuthorName</p>
                <p><strong>Price:</strong> $@book.Price</p>

                <form method="post" action="/Home/RemoveBook" onsubmit="return confirmRemove();">
                    <input type="hidden" name="id" value="@book.Id" />
                    <button type="submit">Remove</button>
                </form>
            </div>
        }
    </div>
}

@section Scripts {
    <script>
        function confirmRemove() {
            return confirm("Remove this book?");
        }
    </script>
}