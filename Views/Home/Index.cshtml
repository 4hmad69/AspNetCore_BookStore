@model AspNetCore_BookStore.ViewModels.HomeViewModel

@{
    ViewData["Title"] = "Book Store";
}

@section Styles {
    <style>
        .book-card {
            border: 1px solid #ccc;
            padding: 20px;
            margin: 10px;
            width: 300px;
            border-radius: 10px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        }

        .book-list {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
        }

        .book-card button {
            margin-top: 10px;
        }
    </style>
}

<h2 class="mb-4">Manage Books & Authors</h2>


<h4>Add New Author</h4>

<form method="post" action="/Home/AddAuthor" class="mb-4">

    <input type="text"
           name="name"
           placeholder="Author Name"
           class="form-control mb-2"
           required />

    <input type="text"
           name="country"
           placeholder="Country"
           class="form-control mb-2"
           required />

    <button type="submit" class="btn btn-primary">
        Add Author
    </button>

</form>

<hr />


<h4>Add New Book</h4>

<form method="post" action="/Home/AddBook" class="mb-4">

    <input type="text"
           name="title"
           placeholder="Book Title"
           class="form-control mb-2"
           required />

    <input type="number"
           name="price"
           placeholder="Price"
           step="0.01"
           min="0"
           class="form-control mb-2"
           required />

    <select name="authorId" class="form-select mb-2" required>

        <option value="">Select Author</option>

        @foreach (var author in Model.Authors)
        {
            <option value="@author.Id">
                @author.Name
            </option>
        }

    </select>

    <button type="submit" class="btn btn-success">
        Add Book
    </button>

</form>

<hr />

<h4 class="mb-3">Book List</h4>

@if (Model.Books.Count == 0)
{
    <div class="alert alert-info">
        No books available.
    </div>
}
else
{
    <div class="book-list">

        @foreach (var book in Model.Books)
        {
            <div class="book-card">

                <h5>@book.Title</h5>

                <p>
                    <strong>Author:</strong>
                    @book.AuthorName
                </p>

                <p>
                    <strong>Price:</strong>
                    $@book.Price.ToString("0.00")
                </p>

                <form method="post"
                      action="/Home/RemoveBook"
                      onsubmit="return confirmRemove()">

                    <input type="hidden"
                           name="id"
                           value="@book.Id" />

                    <button type="submit"
                            class="btn btn-danger btn-sm">
                        Remove
                    </button>

                </form>

            </div>
        }

    </div>
}

@section Scripts {
    <script>
        function confirmRemove() {
            return confirm("Remove this book?");
        }
    </script>
}
